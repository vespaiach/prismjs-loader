{
  "name": "shiki-loader",
  "description": "Browser-only syntax highlighting for code blocks using Shiki",
  "version": "0.1.1",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check",
    "format": "biome format --write",
    "build:lib": "bun build ./src/shiki-loader/index.ts --outfile ./public/shiki-loader.js --target browser --bundle --minify && bun run scripts/embed-loader-css.ts",
    "test": "bun test",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@next/third-parties": "^16.1.6",
    "daisyui": "^5.5.19",
    "next": "^16.1.6",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
